# HSTS inheritance fix (SEC-05, 2026-11-24):
# nginx `add_header` is NOT inherited: any location that defines its own
# add_header loses every server-level add_header, including
# Strict-Transport-Security. Both HTTPS servers set HSTS at server level
# (lines 128, 807), but 28 locations define their own add_headers without
# HSTS, so their responses carry no HSTS header today. This patch adds the
# identical HSTS line (same value as the server level, no preload) after the
# last add_header in each of those 28 locations (14 per HTTPS server).
# NOT touched: the port-80 default server (plain HTTP — HSTS is ignored over
# HTTP), the two Certbot port-80 redirect servers (301 to https), and every
# location that already re-adds HSTS (cached GET routes) or defines no
# add_header at all (inherits server HSTS).
# Anchor: live /etc/nginx/sites-enabled/radd-stream, md5 73fdcff003edb79b246ac77705f27f3e,
# fetched 2026-11-24 (1,465 lines). Gate step: verify `git apply --check`
# against the then-current file, apply, `sudo nginx -t`, reload, then prove
# with `curl -sI` that /api/v2/play, /api/v2/resolve and /api/v1/stream
# responses carry Strict-Transport-Security.
--- a/radd-stream
+++ b/radd-stream
@@ -269,6 +269,7 @@
         add_header Cache-Control "private, no-store" always;
         add_header X-Cache $upstream_cache_status always;
         add_header X-Cache-Status $upstream_cache_status always;
+        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
     }
 
     location = /api/v1/app/remote-config {
@@ -312,6 +313,7 @@
         add_header Cache-Control "private, no-store" always;
         add_header X-Cache $upstream_cache_status always;
         add_header X-Cache-Status $upstream_cache_status always;
+        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
     }
 
     location = /api/v1/search/by-media {
@@ -330,6 +332,7 @@
         add_header Cache-Control "private, no-store" always;
         add_header X-Cache $upstream_cache_status always;
         add_header X-Cache-Status $upstream_cache_status always;
+        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
     }
 
     location = /api/v1/download {
@@ -349,6 +352,7 @@
         add_header Cache-Control "private, no-store" always;
