# HSTS inheritance fix (SEC-05, 2026-11-24; patch regenerated 2026-11-27):
# nginx `add_header` is NOT inherited: any location that defines its own
# add_header loses every server-level add_header, including
# Strict-Transport-Security. Both HTTPS servers set HSTS at server level
# (lines 134, 913), but 28 locations define their own add_headers without
# HSTS, so their responses carry no HSTS header today. This patch adds the
# identical HSTS line (same value as the server level, no preload) after the
# last add_header in each of those 28 locations (14 per HTTPS server).
# NOT touched: the port-80 default server (plain HTTP — HSTS is ignored over
# HTTP), the two Certbot port-80 redirect servers (301 to https), and every
# location that already re-adds HSTS (cached GET routes) or defines no
# add_header at all (inherits server HSTS).
# Anchor: live /etc/nginx/sites-enabled/radd-stream, md5 8378f1196f154179ee300e362fc1145d,
# fetched 2026-11-27 (1,671 lines). Supersedes the 2026-11-24 anchor
# 73fdcff003edb79b246ac77705f27f3e (1,465 lines): the live file drifted since
# (person location, Session 125 comments, CSP/X-Frame/Permissions headers in
# other locations) so the old patch no longer applied; the gap set is
# unchanged — same 14 locations x 2 servers, still 28 insertions.
# Gate step: verify `git apply --check` against the then-current file,
# apply, `sudo nginx -t`, reload, then prove with `curl -sI` that
# /api/v2/play, /api/v2/resolve and /api/v1/stream responses carry
# Strict-Transport-Security.
--- a/radd-stream
+++ b/radd-stream
@@ -296,6 +296,7 @@
         add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
         add_header X-Frame-Options DENY always;
         add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
+        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
     }
 
