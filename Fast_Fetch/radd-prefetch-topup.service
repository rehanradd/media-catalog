[Unit]
Description=Evening top-up: re-warm the top-100 titles at 21:00 PKT (play-fast §2 (j))
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/radd-stream
# The live catalog path, the same value radd-stream.service carries. The
# worker reads it through RADD_DB_PATH at import (config.py freezes DB_PATH),
# so it must be set here rather than left to a --db flag.
Environment=RADD_DB_PATH=/home/ubuntu/radd-stream-data/merged_catalog_20261025.db
# The panel database the worker reads the operator's tuning knobs from
# (panel_feed.tuning_knob: warmup_count, prefetch_queue,
# prefetch_concurrency). Without it the knobs fall back to shipped
# defaults and the panel controls do nothing for this process — the
# same value the live API service carries.
Environment=RADD_ADMIN_V2_DB=/home/ubuntu/admin-v2-workspace-20261105/data-live/admin_v2.db
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# One --topup run of the top 100 titles at 21:00 PKT: the same fill, smaller.
# --max-autocrawl-wait-seconds 2700: the 20:01 autocrawl merge runs until
# ~21:30, so the top-up waits up to 45 min for its lock instead of yielding
# every night. The load wait stays 300 s, and the shared flock still yields
# it at once when a sweep or fill is running. Nice=19 + idle IO class, the
# same deprioritisation as the sweep unit.
ExecStart=/usr/bin/python3 -S /opt/radd-stream/Fast_Fetch/prefetch_worker.py --once --topup --workers 2 --load-ceiling 4.0 --max-wait-seconds 300 --max-autocrawl-wait-seconds 2700
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
