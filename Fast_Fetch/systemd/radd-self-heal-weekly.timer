[Unit]
Description=Weekly self-healing maintenance on Sundays at 07:00, clear of every other job (Branch 6, design §4)

[Timer]
# Sundays 07:00, its OWN timer — never piggybacked on the link sweep.
# Clear of the link sweep (02,08,14,20:30), the prefetch timer
# (00,06,12,18:30), the daily backup (~03:40-06:30), the fleet job
# (03:30), autocrawl (02:00), host-roots (Sun 01:33), themoviebox-sync
# (05:00), prefetch-fill (18:00), topup (21:03) and the domain probe
# (10:30 daily). The job is light (one small JSON sidecar + one log
# file), so the 10-minute random delay is jitter, not load spreading.
OnCalendar=Sun *-*-* 07:00:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
