[Unit]
Description=Daily domain recheck: drain the recheck queue, probe stale sites, heal moves (self-healing Branch 4)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/radd-stream
# The panel database the probe reads the operator's tuning knob from
# (panel_feed.tuning_knob: domain_check_interval_min, the interval
# between domain re-checks). Without it the knob falls back to the
# shipped 6h and the panel control does nothing for this process —
# the same value the live API service carries.
Environment=RADD_ADMIN_V2_DB=/home/ubuntu/admin-v2-workspace-20261105/data-live/admin_v2.db
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# domain_recheck.py --probe-stale (self-healing Branch 4) does three
# things, in order, and logs one JSON line per site:
#   1. drain the domain recheck queue — the sites the sweep's dead/parked
#      rows queued for a discovery-chain recheck (one resolve_site each);
#   2. probe_all_sites(only_stale=True) with the 7-day staleness window
#      (a site is stale when its last_verified is older than 7 days);
#   3. run the full discovery chain for every site the probe finds down.
# Blocked / unverifiable sites are left alone (a WAF refusal is not a
# death and never triggers the chain), and resolve-all is never run —
# the chain runs only for queued or down sites, never for all 33 at once.
# The queue sidecar (domain_recheck_queue.db) sits next to the catalog
# DB given by --db. 33 sites at a few probes each finishes in minutes;
# the 30-minute start timeout is headroom for slow hosts, not an
# expectation.
ExecStart=/usr/bin/python3 -S /opt/radd-stream/Fast_Fetch/domain_recheck.py --db /home/ubuntu/radd-stream-data/merged_catalog_20261025.db --probe-stale
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
