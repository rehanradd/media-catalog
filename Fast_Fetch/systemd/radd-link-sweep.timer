[Unit]
Description=Link-health sweep every 6 hours, offset from the prefetch slots (Phase 1 sweep rate)

[Timer]
# Every 6 hours at :30 past, 2 hours offset from the prefetch timer
# (00,06,12,18:30) so no two heavy jobs share a slot, and clear of the
# daily backup at 03:40 — the runner also yields if the prefetch sweep or
# the backup is running when it fires, so a slow run never overlaps one.
OnCalendar=*-*-* 02,08,14,20:30:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
