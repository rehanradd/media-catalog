<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No `usesCleartextTraffic` here, and that is not an oversight: once the
      application declares a `networkSecurityConfig`, the platform ignores
      `usesCleartextTraffic` entirely. Debug gets its cleartext from this source
      set's own override of res/xml/network_security_config.xml, which permits any
      origin so a developer can aim the app at whatever machine they are testing.
      Release uses the generated policy — one host, from /brand.properties.
    -->
    <application>
        <!--
          Firebase Sessions is off in debug (and therefore in unit tests,
          which run against the debug variant): under Robolectric the
          Sessions client binds through an android.os.Messenger with no
          target and throws NullPointerException on a Firebase background
          thread (SessionLifecycleClient.kt:175 via ShadowMessenger.send).
          Telemetry's uncaught-exception handler swallows it only if
          installed before the thread fires, which is a race (Firebase
          initialises via its ContentProvider, before Application.onCreate).
          Sessions is production telemetry; a debug build does not need it,
          and release is unaffected. A src/test/AndroidManifest.xml with the
          same metadata did not take effect, so it lives here.
        -->
        <meta-data
            android:name="firebase_sessions_enabled"
            android:value="false" />
    </application>
</manifest>
