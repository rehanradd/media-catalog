<?xml version="1.0" encoding="utf-8"?>
<!--
    Disable Firebase Sessions for unit tests. Under Robolectric the Sessions
    client binds through an android.os.Messenger with no target and throws
    NullPointerException on a Firebase background thread
    (SessionLifecycleClient.kt:175 via ShadowMessenger.send). Telemetry's
    uncaught-exception handler swallows it only if installed before the
    thread fires, which is a race (Firebase initialises via its
    ContentProvider, before Application.onCreate) — it failed
    ScreenSnapshotTest in runs 45103781080 and 45104753146. Sessions is a
    production telemetry feature; no unit test needs it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="firebase_sessions_enabled"
            android:value="false" />
    </application>
</manifest>
