 #    live in nginx.conf (Session 125 A6) — the report's 768 baseline is stale.
 #    nginx.conf is UNCHANGED; no ceiling change is needed. Do NOT lower to 2048.
 # ============================================================================
+# Real client IP behind Cloudflare (scale bottleneck #1, 2026-11-20):
+# http context, so it applies to every server in this file (DuckDNS
+# and ccwu.cc API servers and the default server). Without this,
+# $remote_addr is the Cloudflare edge IP, so limit_req/limit_conn key
+# per edge instead of per user. The ranges below are Cloudflare's
+# published lists (cloudflare.com/ips-v4 and /ips-v6, fetched
+# 2026-11-20); a peer outside them keeps its own address, so the
+# direct-IP/DuckDNS backup path is unaffected. real_ip_recursive is
+# not set: CF-Connecting-IP carries a single address, not a chain,
+# so there is nothing to recurse over.
+set_real_ip_from 173.245.48.0/20;
+set_real_ip_from 103.21.244.0/22;
+set_real_ip_from 103.22.200.0/22;
